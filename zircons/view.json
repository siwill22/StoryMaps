{
  "explorer": 1,
  "title": "Igneous zircons through deep time",
  "subtitle": "Drag to rotate, scroll to zoom. A sample brightens within 5 Myr of its crystallisation age, then fades but stays visible once formed.",
  "projection": "orthographic",
  "theme": "abyssal",
  "camera": { "lon": -60, "lat": 10, "zoom": 1.0 },
  "time": { "start": 0, "end": 1000, "step": 1, "initial": 300, "playRate": 25 },
  "credit": { "model": "Merdith2021", "modelLabel": "Merdith et al. (2021)" },
  "caption": "Continent polygons include the submerged shelf, so they run wider than a coastline.",
  "layers": [
    { "kind": "ocean" },
    { "kind": "continents", "url": "data/continents.json" },
    { "kind": "boundaries", "url": "data/boundaries.json" },
    {
      "kind": "velocities",
      "label": "Velocity arrows",
      "url": "data/velocities.json"
    },
    {
      "kind": "points",
      "id": "points",
      "lifespan": "since",
      "size": 3.1,
      "rule": { "type": "age_window", "window": 5, "fade": 0.07 },
      "colours": { "Felsic": "#ff5fae", "Mafic": "#19e88f" },
      "legend": { "title": "Igneous zircons", "counts": true },
      "hover": {
        "eyebrow": "type",
        "title": ["sample_id"],
        "titleFallback": "Unnamed sample",
        "rows": [
          { "key": "age", "label": "Age", "unit": "Ma",
            "error": "age_uncertainty", "errorUnit": "Myr" },
          { "key": "age_type", "label": "Dated by" },
          { "key": "rock_type", "label": "Rock type" },
          { "key": "locality", "label": "Locality" },
          { "key": "country", "label": "Region" },
          { "key": "continent", "label": "Continent" },
          { "key": "plate_id", "label": "Plate" }
        ],
        "footer": "reference"
      },
      "url": "data/points.json"
    }
  ],
  "charts": {
    "sources": [
      {
        "url": "data/boundary_length.csv",
        "series": {
          "subduction_km": { "label": "Subduction", "unit": "km",
                              "colour": "@boundary.subduction" }
        }
      },
      {
        "url": "data/zircon_histogram.csv",
        "series": {
          "zircon_count": { "label": "Zircons formed / 20 Myr", "colour": "#8fd4f0" }
        }
      }
    ]
  }
}
