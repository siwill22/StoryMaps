# Ignore everything by default; only southeast-tasmania, zircons,
# detrital-zircons, and the shared engine/data they depend on are committed
# for now. Other story-map folders (southern-ocean-gateways, spilhaus-*) stay
# local until they're ready.
*

!.gitignore
!README.md

!shared/
!shared/**

!southeast-tasmania/
!southeast-tasmania/**

!zircons/
!zircons/**
zircons/data/

!detrital-zircons/
!detrital-zircons/**
detrital-zircons/data/

# Still exclude OS/tooling cruft even inside tracked folders.
.DS_Store
__pycache__/
*.pyc
